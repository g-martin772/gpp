# Run as a script (cmake -P) on every build: writes OUTPUT only when the content changes.
file(STRINGS "${LIST_FILE}" files)
list(SORT files)
set(acc "${PREFIX}")
foreach (file IN LISTS files)
    file(SHA256 "${file}" digest)
    string(APPEND acc "${digest}")
endforeach ()
string(SHA256 total "${acc}")
string(SUBSTRING "${total}" 0 16 short)
set(content "#pragma once\n#define GPP_HOT_RELOAD_SOURCE_HASH \"${PREFIX}/${short}\"\n")
set(current "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" current)
endif ()
if (NOT current STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif ()
