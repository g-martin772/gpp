#version 450
#include "particle_common.glsl"

layout(local_size_x = 64) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= st[ST_USED]) return;
    vec4 pm = curPos[i];
    for (uint c = 0u; c < MP.colliderCount; ++c)
    {
        if (MP.colliders[c].info.x != 2u) continue;
        vec3 normal, surface;
        if (pfInside(MP.colliders[c], pm.xyz, 0.0, normal, surface)) pfFixedAdd(ACC_DRAG + 2u * c, pm.w, MP.invScale);
    }
}
