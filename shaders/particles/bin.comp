#version 450
#include "particle_common.glsl"
#include "force_model.glsl"

layout(local_size_x = 256) in;

shared uint shHist[PF_BINS];

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint i = gl_GlobalInvocationID.x;
    uint pending = st[ST_PENDING];
    if (tid < uint(PF_BINS)) shHist[tid] = 0u;
    barrier();

    if (i < pending)
    {
        uvec4 meta = curMeta[i];
        uint bin = uint(PF_DEAD);
        if ((meta.y & 1u) != 0u)
        {
            vec4 pm = curPos[i];
            vec4 vt = curVel[i];
            float stable = pfStableStep(pm.xyz, vt.xyz, MP.eta, MP.force);
            bin = pfAssignBin(MP.baseStep, stable, uint(PF_MAX_BIN));
        }
        curMeta[i].y = (meta.y & 1u) | (bin << 8u);
        atomicAdd(shHist[bin], 1u);
    }
    barrier();
    if (tid < uint(PF_BINS)) hist[gl_WorkGroupID.x * uint(PF_BINS) + tid] = shHist[tid];
}
