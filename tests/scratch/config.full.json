{
  "GPP": {
    "Graphics": {
      "Window": {
        "Width": 1600,
        "Height": 900,
        "Fullscreen": false,
        "Headless": false,
        "Title": "Scratch"
      },
      "Windows": [
        {
          "Name": "configured",
          "Width": 900,
          "Height": 650,
          "Fullscreen": false,
          "Resizable": true,
          "Title": "Configured Window",
          "ImGui": {
            "ConfigFlags": ["DockingEnable"],
            "EnableDockSpace": false
          }
        }
      ],
      "Render": {
        "ShaderAssetDirectories": ["shaders"],
        "EnableShaderHotReload": true,
        "ShaderHotReloadIntervalMilliseconds": 250
      },
      "LayerHotReload": {
        "Enabled": true,
        "PollingIntervalMilliseconds": 300,
        "ShadowDirectory": ".gpp/hot-reload-cache",
        "ShadowCopy": true
      },
      "ImGui": {
        "ConfigFlags": ["DockingEnable", "ViewportsEnable", "NavEnableKeyboard"],
        "EnableDockSpace": true
      },
      "Theme": {
        "LibraryPath": "",
        "EnableHotReload": false,
        "PollingIntervalMilliseconds": 300
      },
      "Fonts": {
        "FontDirectories": ["fonts"],
        "DefaultFont": "",
        "DefaultFontSize": 16.0,
        "UiScale": 1.0
      }
    }
  }
}